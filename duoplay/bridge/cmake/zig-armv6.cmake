# Cross-compiles the bridge for Raspberry Pi Zero / Zero W / Pi 1 (ARMv6, hard float)
# with Zig's clang and musl, fully static: one file that runs on any Raspberry Pi OS
# (32- or 64-bit) with nothing else installed. scripts/build-pi.sh sets this up.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR armv6l)
if(NOT DUOPLAY_XARM)
	set(DUOPLAY_XARM "$ENV{DUOPLAY_XARM}")
endif()
set(DUOPLAY_XARM "${DUOPLAY_XARM}" CACHE PATH "Folder with the zig wrappers (bin/) and the ARMv6 OpenSSL (sysroot/)")
set(CMAKE_C_COMPILER "${DUOPLAY_XARM}/bin/zcc")
set(CMAKE_CXX_COMPILER "${DUOPLAY_XARM}/bin/zcxx")
set(CMAKE_AR "${DUOPLAY_XARM}/bin/zar" CACHE FILEPATH "" FORCE)
set(CMAKE_RANLIB "${DUOPLAY_XARM}/bin/zranlib" CACHE FILEPATH "" FORCE)
set(CMAKE_FIND_ROOT_PATH "${DUOPLAY_XARM}/sysroot")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(OPENSSL_ROOT_DIR "${DUOPLAY_XARM}/sysroot")
set(OPENSSL_USE_STATIC_LIBS TRUE)
set(CMAKE_EXE_LINKER_FLAGS_INIT "-static -s")
set(DUOPLAY_MUSL ON CACHE BOOL "Building against musl libc" FORCE)
